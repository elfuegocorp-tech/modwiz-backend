# Supabase CLI local state — which project this checkout is linked to. Machine
# state, not project state; committing it makes every clone think it is linked.
supabase/.temp/

# Generated by sql/supabase-migration/bundle.sh — a concatenation of the three
# numbered files, regenerable at any time. Committing it would mean two copies
# of the schema that can silently disagree.
sql/supabase-migration/_bundle.generated.sql

.DS_Store
